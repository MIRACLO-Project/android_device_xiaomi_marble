<!--
     SPDX-FileCopyrightText: MIRACLO
     SPDX-License-Identifier: Apache-2.0

     Read only on the Indian model (ro.boot.hardware.sku = marblein), which has no NFC chip.
     Xiaomi's vendor image declares NFC for every marble; without these lines the NFC module
     waits forever for hardware that is not there and is killed as "not responding" every
     15 seconds. With NFC not declared, it exits at once.
-->
<permissions>
    <unavailable-feature name="android.hardware.nfc" />
    <unavailable-feature name="android.hardware.nfc.any" />
    <unavailable-feature name="android.hardware.nfc.hce" />
    <unavailable-feature name="android.hardware.nfc.hcef" />
    <unavailable-feature name="android.hardware.nfc.uicc" />
    <unavailable-feature name="android.hardware.nfc.ese" />
    <unavailable-feature name="android.hardware.nfc.ese.ese1" />
    <unavailable-feature name="android.hardware.nfc.offhost_hce" />
    <unavailable-feature name="android.hardware.se.omapi.ese" />
    <unavailable-feature name="android.hardware.se.omapi.uicc" />
</permissions>
